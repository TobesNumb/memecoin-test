# Kopieer dit bestand naar .env en vul het in. .env staat in .gitignore en komt NOOIT in git.

# Netwerk waarop de scripts werken: "devnet" (testen) of "mainnet" (echt geld).
# De launch-flag --network moet hiermee overeenkomen, anders stopt het script.
NETWORK=devnet

# RPC-URL. Voor devnet volstaat de publieke RPC. Voor mainnet raden we een eigen
# RPC-provider aan (bijv. Helius, QuickNode, Triton); de publieke mainnet-RPC is
# traag en beperkt.
RPC_URL=https://api.devnet.solana.com
# RPC_URL=https://api.mainnet-beta.solana.com

# Pad naar het keypair-bestand van de launch-wallet (aangemaakt met `npm run wallet:create`).
# Het pad is relatief aan de projectmap. Dit bestand staat in .gitignore.
KEYPAIR_PATH=./keys/wallet.json

# Optioneel: priority fee in micro-lamports per compute unit (standaard 0).
# Op mainnet helpt een kleine priority fee om de transactie sneller te laten landen.
# PRIORITY_FEE_MICRO_LAMPORTS=0
